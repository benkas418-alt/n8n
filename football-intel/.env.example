# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection (main database).
DATABASE_URL=postgresql+psycopg://footintel:CHANGE_ME@localhost:5432/footintel

# Optional. Without a key, the API-Football connector stays disabled and the
# app runs in degraded mode on local football-data.co.uk data.
# Free key: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# Token required by write endpoints of the HTTP API (user predictions, admin).
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# Local folders for raw downloads, model artifacts and reports.
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
REPORTS_DIR=./reports

# Display and scheduling timezone.
TIMEZONE=Africa/Lubumbashi

# Optional Telegram notifications (leave empty to disable).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
